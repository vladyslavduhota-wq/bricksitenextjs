# Supabase project (EU region). Public values, safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Session pooler connection string, used to apply migrations.
SUPABASE_DB_URL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Cloudflare Turnstile bot check on sign-in (site key; the secret goes into Supabase).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# DB tests: a throwaway local Postgres database. It is wiped on every run.
TEST_DATABASE_URL=postgres://localhost:5432/brik_auction_test
